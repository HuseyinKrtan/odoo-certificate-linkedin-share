<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="survey_fill_form_done_certificate_linkedin"
              inherit_id="survey.survey_fill_form_done"
              name="Certificate URL &amp; LinkedIn Share Button">

        <xpath expr="//a[hasclass('btn-primary')]" position="after">

            <div t-if="answer.certificate_url" class="mt-3 o_certificate_linkedin_share">

                <!-- Certificate URL -->
                <p class="mb-2">
                    <strong>Certificate URL:</strong>
                    <a t-att-href="answer.certificate_url" t-esc="answer.certificate_url" target="_blank"/>
                </p>

                <!-- Add to LinkedIn button -->
                <button type="button"
                        id="o_certificate_linkedin_btn"
                        class="btn o_certificate_linkedin_btn"
                        t-att-data-cert-url="answer.certificate_url"
                        t-att-data-cert-name="answer.survey_id.display_name"
                        t-att-data-org-name="answer.certificate_organization"
                        t-att-data-org-id="answer.certificate_organization_id"
                        t-att-data-issue-year="answer.certificate_issue_year"
                        t-att-data-issue-month="answer.certificate_issue_month">
                    <i class="fa fa-linkedin-square me-1"/> Add to LinkedIn
                </button>
            </div>
        </xpath>
    </template>
</odoo>
