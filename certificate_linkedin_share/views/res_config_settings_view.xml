<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_certificate_linkedin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.certificate.linkedin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Certificate LinkedIn" name="certificate_linkedin_share">
                    <block title="Certificate LinkedIn Share">
                        <setting string="LinkedIn Organization ID"
                                 help="Kendi şirketinizin LinkedIn Sayfa (Page) ID'sini buraya yazmalısınız — bu, sertifikaların LinkedIn'de doğrudan şirketinizin resmi sayfasına bağlanmasını sağlar. Bilmiyorsanız veya bir LinkedIn şirket sayfanız yoksa boş bırakabilirsiniz; bu durumda sadece şirket adınız kullanılır ve herhangi bir hata oluşmaz.">
                            <field name="linkedin_organization_id" placeholder="ör. 12345678"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
